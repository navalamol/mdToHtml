{
  "$comment": "Registry mapping source paths to knowledge areas. Paths are globs relative to the repository root. Consumed by the knowledge-sync skill scripts kb_impact.py and kb_lint.py.",
  "version": 1,
  "knowledge_root": ".claude/knowledge",
  "source_root": "",
  "source_extensions": [".ts", ".tsx"],
  "symbol_extensions": [".ts", ".tsx"],
  "areas": {
    "rpc-layer": {
      "title": "RPC Layer",
      "primary": [
        "packages/core-contracts/src/**",
        "packages/orpc/src/builder.ts",
        "packages/orpc/src/context.ts",
        "packages/orpc/src/router.ts",
        "packages/orpc/src/procedures/**",
        "packages/orpc/src/clients/**",
        "packages/orpc/src/utils/**",
        "packages/orpc/src/middleware/auth.ts",
        "packages/orpc/src/middleware/api-client.ts",
        "packages/orpc/src/middleware/span-attributes.ts",
        "apps/*/src/integrations/orpc/**",
        "apps/*/src/routes/rpc/**",
        "apps/*/src/routes/openapi/**"
      ],
      "secondary": []
    },
    "error-handling": {
      "title": "Error Handling",
      "primary": [
        "packages/orpc/src/errors.ts",
        "packages/orpc/src/upstream-error.ts",
        "packages/orpc/src/middleware/error-recording.ts",
        "packages/orpc/src/middleware/validation-error.ts",
        "packages/app-shell/src/error-toast.ts",
        "packages/app-shell/src/query/error-cache.ts",
        "apps/*/src/lib/error-toast.ts",
        "apps/*/src/integrations/tanstack-query/error-cache.ts",
        "apps/*/src/components/RouteErrorComponent.tsx"
      ],
      "secondary": [
        "packages/core-contracts/src/types/error-key.ts",
        "packages/core-contracts/src/schemas/error-payload-schema.ts"
      ]
    },
    "permissions": {
      "title": "Permissions",
      "primary": [
        "packages/app-shell/src/permissions/**",
        "packages/core-contracts/src/permissions/**",
        "apps/*/src/lib/permissions/**",
        "apps/*/src/lib/navigation-config.ts"
      ],
      "secondary": []
    },
    "forms": {
      "title": "Forms",
      "primary": [
        "packages/app-shell/src/components/UnsavedChangesGuard.tsx",
        "apps/*/src/components/_shared/UnsavedChangesGuard.tsx",
        "apps/*/src/components/**/use-*-form.ts",
        "apps/*/src/components/**/*-schema.ts",
        "apps/pxc-retail/src/components/vendor/_shared/forms/**",
        "apps/pxc-retail/src/components/vendor/profile/*Dialog.tsx",
        "apps/tenant-management/src/components/features/*Form.tsx",
        "apps/tenant-management/src/components/tenant-detail/AddMappingForm.tsx",
        "apps/tenant-management/src/components/tenant-detail/TenantDetailsSection.tsx",
        "apps/tenant-management/src/components/tenant-entitlements/AssignmentDialog.tsx",
        "apps/tenant-management/src/components/tenant-entitlements/GrantDialog.tsx"
      ],
      "secondary": []
    }
  }
}
